# ─── Général ───────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL (instance partagée : base `learnup` pour Directus, `learnup_api` pour l'API)
POSTGRES_USER=learnup
POSTGRES_PASSWORD=learnup
POSTGRES_DB=learnup

# ─── Redis (cache Directus) ───────────────────────────────────
# Pas de variables dédiées : Directus s'y connecte via redis://redis:6379
# (voir docker-compose.yml). Local uniquement, pas de mot de passe.

# ─── MinIO (S3-compatible, stockage média Directus) ────────────
MINIO_ROOT_USER=learnup
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=learnup-media
# Console d'admin MinIO : http://localhost:9001

# ─── Directus (back-office) ────────────────────────────────────
# KEY/SECRET : chaînes aléatoires pour la signature interne (JWT, etc.).
# Générer en local avec `openssl rand -hex 32`. Uniquement pour le dev.
DIRECTUS_KEY=change-me-directus-key
# 32 bytes minimum (Directus avertit sinon) — valeur de dev, à régénérer
# pour tout environnement partagé.
DIRECTUS_SECRET=change-me-run-openssl-rand-hex-32
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me-admin

# ─── API (NestJS) ──────────────────────────────────────────
API_PORT=3001
# Origines autorisées par le CORS (séparées par des virgules)
# `*` = wildcard sur un label DNS (ex. https://*.vercel.app pour les previews Vercel)
CORS_ORIGIN=http://localhost:3000,https://*.vercel.app
# Clé pour les routes d'administration (/admin/*)
ADMIN_API_KEY=change-me-admin-api-key
# Journal des recherches sans résultat (collection Directus
# recherches_sans_resultat) : durée de conservation en jours (0 = pas de
# purge). La purge est déclenchée chaque nuit par le workflow GitHub
# `.github/workflows/search-misses-purge.yml` (POST /admin/search-misses/purge).
SEARCH_MISS_RETENTION_DAYS=180
# Moteur IA — retrieval sur le catalogue publié (index en mémoire, BM25 +
# embeddings). Provider d'embeddings : `hashing` (défaut, local, sans clé —
# similarité lexicale approchée) ou `http` (API au format OpenAI
# /v1/embeddings : Voyage, Mistral, OpenAI… — fournisseur à confirmer).
EMBEDDINGS_PROVIDER=hashing
# EMBEDDINGS_API_URL=https://api.voyageai.com/v1/embeddings
# EMBEDDINGS_API_KEY=change-me-embeddings-key
# EMBEDDINGS_MODEL=voyage-3.5-lite
# Token statique Directus pour l'API (miroir catalogue — lecture/écriture).
# Le proxy public /directus n'utilise PAS ce token : il relaie sans auth sous
# le rôle Public Directus (lecture seule, published, champs restreints).
DIRECTUS_TOKEN=change-me-directus-token
# URL interne Directus depuis l'API (Docker)
DIRECTUS_INTERNAL_URL=http://localhost:8055
# Cache (base de données retirée — Directus est la source de vérité)
REDIS_URL=redis://localhost:6379
# Secret partagé front→API : les fetches SSR envoient `x-internal-ssr` pour
# bypasser le rate-limit public (sinon tous les visiteurs partageraient le
# bucket de l'IP du serveur Nuxt). Côté front : NUXT_INTERNAL_API_TOKEN.
# Générer avec `openssl rand -hex 32`.
INTERNAL_API_TOKEN=change-me-internal-api-token
# Invalidation de cache pilotée par les flows Directus (« Invalidate site
# cache », « Geocode centre on address change »…) créés par
# `pnpm directus:build`. Les opérations lisent `{{ $env.* }}` À L'EXÉCUTION,
# depuis l'env du container Directus — ces variables doivent donc être
# posées sur le service `directus` (déjà fait dans docker-compose.yml,
# allow-list FLOWS_ENV_ALLOW_LIST comprise) — pas seulement au build.
# URLs vues DEPUIS Directus : hôte en dev (`host.docker.internal`,
# le défaut ci-dessous), services compose ou domaines publics en déployé.
API_INTERNAL_URL=http://host.docker.internal:3001
FRONT_INTERNAL_URL=http://host.docker.internal:3000
# Secret Directus → front : purge du cache ISR (header x-cache-secret).
# Générer avec `openssl rand -hex 32`.
NUXT_CACHE_PURGE_SECRET=change-me-cache-purge-secret
# Revalidation ISR à la demande sur Vercel (header x-prerender-revalidate) —
# lu au build (nitro.vercel.config.bypassToken) et au runtime. Vercel only.
NUXT_ISR_BYPASS_TOKEN=change-me-isr-bypass-token

# ─── Recherche assistée (IA) ────────────────────────────────
# API chat completions compatible OpenAI (SDK `openai` côté api).
# Par défaut OpenRouter — un seul client pour tous les modèles :
# gratuit en dev, anthropic/* en prod une fois validé.
# Sans clé ou si le modèle ne répond pas, POST /assistant/message bascule sur
# la recherche déterministe du catalogue (mode dégradé, sans IA) ; 503 (état
# « indisponible ») seulement si le catalogue lui-même est inaccessible.
ASSISTANT_BASE_URL=https://openrouter.ai/api/v1
ASSISTANT_API_KEY=change-me-openrouter-key
# Modèle (défaut gratuit dev stealth/space-bunny-alpha ;
# prod : anthropic/claude-haiku-4.5 via le même endpoint OpenRouter).
ASSISTANT_MODEL=stealth/space-bunny-alpha
# Mode dégradé : délai max (ms) laissé à la réponse IA avant bascule sur la
# recherche déterministe.
ASSISTANT_AI_TIMEOUT_MS=30000
# Effort de reasoning OpenRouter : low (défaut), medium, high ou off.
# `low` suffit pour la décision JSON et divise la latence par ~2 sur les
# modèles à reasoning (stealth, nemotron, claude avec thinking).
ASSISTANT_REASONING_EFFORT=low

# ─── Directus MCP ───────────────────────────────────────────
# Créer un token statique pour un utilisateur dédié dans Directus.
DIRECTUS_MCP_TOKEN=change-me-directus-mcp-token

# ─── Outils & qualité ───────────────────────────────────────
# GitHub MCP (PAT, scopes repo:read, issues:write, pr:write). Fine-grained : `github_pat_…`, classic : `ghp_`.
GITHUB_TOKEN=github_pat_change_me
# SonarQube / SonarCloud
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=change-me-sonar-token
SONAR_ORGANIZATION=learnup
# Context7 MCP
CONTEXT7_API_KEY=change-me-context7

# ─── Front (Nuxt) ──────────────────────────────────────────
# Le front ne contacte jamais Directus directement : l'API expose un proxy
# `/directus` (apps/api/src/directus). NUXT_API_BASE est utilisé par le rendu
# SSR (côté serveur uniquement), NUXT_PUBLIC_API_BASE par le navigateur.
NUXT_API_BASE=http://localhost:3001
NUXT_PUBLIC_API_BASE=http://localhost:3001
# Doit matcher INTERNAL_API_TOKEN côté API (bypass rate-limit SSR).
NUXT_INTERNAL_API_TOKEN=change-me-internal-api-token
# Google Tag Manager (container GTM, ex: GTM-XXXXXXX)
NUXT_PUBLIC_GTM_ID=GTM-XXXXXXX
