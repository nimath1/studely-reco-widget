# ─── Général ───────────────────────────────────────────────
NODE_ENV=development

# ─── API (NestJS) ──────────────────────────────────────────
API_PORT=3001
# Origines autorisées par le CORS (séparées par des virgules)
# `*` = wildcard sur un label DNS (ex. https://*.vercel.app pour les previews Vercel)
CORS_ORIGIN=http://localhost:3000,https://*.vercel.app
# Clé pour les routes d'administration (/admin/*)
ADMIN_API_KEY=change-me-admin-api-key
# Cache et stockage du rate limiting (local, sans mot de passe)
REDIS_URL=redis://localhost:6379
# Secret partagé front→API : les fetches SSR envoient `x-internal-ssr` pour
# bypasser le rate-limit public (sinon tous les visiteurs partageraient le
# bucket de l'IP du serveur Nuxt). Côté front : NUXT_INTERNAL_API_TOKEN.
# Générer avec `openssl rand -hex 32`.
INTERNAL_API_TOKEN=change-me-internal-api-token

# ─── Outils & qualité ───────────────────────────────────────
# GitHub MCP (PAT, scopes repo:read, issues:write, pr:write). Fine-grained : `github_pat_…`, classic : `ghp_`.
GITHUB_TOKEN=github_pat_change_me
# SonarQube / SonarCloud
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=change-me-sonar-token
SONAR_ORGANIZATION=learnup
# Context7 MCP
CONTEXT7_API_KEY=change-me-context7
