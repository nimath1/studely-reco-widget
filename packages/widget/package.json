{
  "name": "@studely/widget",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode production && pnpm size",
    "build:vercel": "pnpm build && vite build --config vite.site.config.ts --mode production && node scripts/package-release.mjs",
    "build:staging": "tsc --noEmit && vite build --mode staging && pnpm size",
    "build:production": "tsc --noEmit && vite build --mode production && pnpm size",
    "size": "node scripts/check-size.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint \"**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^3.0.5",
    "@vue/server-renderer": "^3.5.44",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^3.0.5",
    "vue": "^3.5.44"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "petite-vue": "0.4.1"
  }
}
